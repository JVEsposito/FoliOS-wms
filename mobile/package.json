{
  "name": "estiba-wms-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.6",
    "expo-build-properties": "~57.0.5",
    "expo-crypto": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-image-picker": "~57.0.19",
    "expo-screen-orientation": "~57.0.1",
    "expo-sharing": "~57.0.0",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.7",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "cross-env": "^10.1.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:demo": "cross-env ESTIBA_APP_VARIANT=demo EXPO_PUBLIC_DEMO_MODE=true EXPO_PUBLIC_DEMO_ONLY=true EXPO_PUBLIC_API_URL= expo start --clear",
    "start:pda": "cross-env ESTIBA_APP_VARIANT=pda EXPO_PUBLIC_APP_VARIANT=pda expo start --clear",
    "start:clear": "expo start --clear",
    "start:tunnel": "expo start --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "export:android": "expo export --clear --platform android --output-dir dist",
    "export:pda": "cross-env ESTIBA_APP_VARIANT=pda EXPO_PUBLIC_APP_VARIANT=pda expo export --clear --platform android --output-dir dist-pda",
    "export:demo": "cross-env ESTIBA_APP_VARIANT=demo EXPO_PUBLIC_DEMO_MODE=true EXPO_PUBLIC_DEMO_ONLY=true EXPO_PUBLIC_API_URL= expo export --clear --platform android --output-dir dist-demo",
    "eas:configure": "npx eas-cli@latest update:configure",
    "build:apk": "npx eas-cli@latest build -p android --profile apk-camaras",
    "build:apk:demo": "npx eas-cli@latest build -p android --profile apk-demo",
    "build:apk:pda": "npx eas-cli@latest build -p android --profile apk-pda",
    "update:production": "npx eas-cli@latest update --channel production --environment production",
    "update:pda": "cross-env ESTIBA_APP_VARIANT=pda EXPO_PUBLIC_APP_VARIANT=pda npx eas-cli@latest update --channel pda --environment production"
  },
  "private": true
}
