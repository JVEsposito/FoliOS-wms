{
  "cli": {
    "version": ">= 21.0.1",
    "appVersionSource": "local"
  },
  "build": {
    "apk-demo": {
      "distribution": "internal",
      "channel": "demo",
      "env": {
        "ESTIBA_APP_VARIANT": "demo",
        "EXPO_PUBLIC_DEMO_MODE": "true",
        "EXPO_PUBLIC_DEMO_ONLY": "true",
        "EXPO_PUBLIC_API_URL": ""
      },
      "android": {
        "buildType": "apk"
      }
    },
    "apk-camaras": {
      "distribution": "internal",
      "channel": "production",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      }
    },
    "apk-pda": {
      "distribution": "internal",
      "channel": "pda",
      "env": {
        "ESTIBA_APP_VARIANT": "pda",
        "EXPO_PUBLIC_APP_VARIANT": "pda"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "apk-pda-pruebas": {
      "distribution": "internal",
      "channel": "pda-pruebas",
      "env": {
        "ESTIBA_APP_VARIANT": "pda",
        "EXPO_PUBLIC_APP_VARIANT": "pda"
      },
      "android": {
        "buildType": "apk"
      }
    }
  }
}
