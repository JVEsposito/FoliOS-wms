{
  "expo": {
    "name": "FoliOS",
    "slug": "estiba-wms-camaras",
    "version": "1.5.0",
    "icon": "./assets/icon.png",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/4c609028-6c9f-4bbe-9c4e-2aff780c4244"
    },
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "cl.estiba.wms.camaras",
      "versionCode": 7,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#183442"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "./plugins/withAsyncStorageSize",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Permite a FoliOS fotografiar defectos durante la recepción.",
          "photosPermission": "Permite a FoliOS seleccionar fotos de defectos y guías.",
          "microphonePermission": false
        }
      ],
      "expo-screen-orientation",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "4c609028-6c9f-4bbe-9c4e-2aff780c4244"
      }
    }
  }
}
