APP_NAME="FoliOS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_OPERATIONAL_TIMEZONE=America/Santiago

# Nombre mostrado en el encabezado de Oficina (ejemplo: "Agro Rosario").
ESTIBA_PLANTA_NOMBRE=

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CL

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

TELESCOPE_ENABLED=true
SANCTUM_TRACK_LAST_USED_AT=false

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=estiba_wms
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=900

CACHE_STORE=database
GERENCIA_CACHE_SECONDS=60
WMS_PLANNER_MODE=off
WMS_PLANNER_COMPUTE=server
WMS_PLANNER_HORIZON=batch
WMS_PLANNER_ARBITRATION_REFRESH_SECONDS=240
WMS_PLANNER_ARBITRATION_STALE_SECONDS=300
WMS_PLANNER_FRONTIER_MAX=4
WMS_PLANNER_MAX_ACTIVE_MANEUVERS=3
WMS_PLANNER_ROLLOUT_CAMERAS=
WMS_PLANNER_CAMARA_PREFERENTE_DESPACHO=
WMS_PLANNER_STALE_TASK_MINUTES=30
WMS_REPA_BUFFER_HIGH_FROM_PALLETS=8
WMS_REPA_BUFFER_MAX_PALLETS=10
# Compatibilidad temporal con generadores que todavía leen la bandera histórica.
WMS_PLANIFICADOR_AUTOMATICO=false
WMS_RESERVA_TAREA_MINUTOS=10
# Exige últimos 4 dígitos del folio y PIN operacional al retirar un pallet.
WMS_CONFIRMACION_INICIO_TAREA=true
# Lote MP y proceso de packing obligatorios al validar pallets; activar tras instalar el APK que los pide.
WMS_VALIDACION_EXIGE_LOTE_PROCESO=false
# Archivo de temporadas cerradas (docs/ARCHIVO_TEMPORADAS.md).
ARCHIVO_TEMPORADAS_DISK=archivo_temporadas
# ARCHIVO_TEMPORADAS_RUTA=/mnt/respaldos/estiba
ARCHIVO_TEMPORADAS_DIAS_CIERRE=60
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
